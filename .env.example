# TNA Provider Backend Configuration
# Copy to .env and fill in real values

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_BOOKING_URL: Optional booking link for the "Book a 15-minute project call" CTA.
# If not set, the CTA will fall back to phone/email contact options.
VITE_BOOKING_URL=

# Mail server backend
MAIL_PROVIDER=mock
MAIL_BASE_URL=https://mail.tnaprovider.com.au
MAIL_JMAP_URL=https://mail.tnaprovider.com.au/jmap
MAIL_IMAP_HOST=mail.tnaprovider.com.au
MAIL_SMTP_HOST=mail.tnaprovider.com.au
MAIL_SMTP_PORT=587
MAIL_DOMAIN=tnaprovider.com.au
MAIL_FROM_DEFAULT=info@tnaprovider.com.au
MAIL_ADMIN_TOKEN=change-me

# Frontend
VITE_EMAIL_MOCK_MODE=true
