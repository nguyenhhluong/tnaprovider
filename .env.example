# TNA Provider Backend Configuration
# Copy to .env and fill in real values

HOST=127.0.0.1
PORT=3000

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_BOOKING_URL: Optional booking link for the "Book a 15-minute project call" CTA.
# If not set, the CTA will fall back to phone/email contact options.
VITE_BOOKING_URL=

# Mail provider: mock | smtp | imap-smtp
MAIL_PROVIDER=mock

# SMTP outbound (used when MAIL_PROVIDER=smtp or imap-smtp)
MAIL_SMTP_HOST=mail.tnaprovider.com.au
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=info@tnaprovider.com.au
MAIL_SMTP_PASS=change-me

# IMAP inbound (used when MAIL_PROVIDER=imap-smtp)
MAIL_IMAP_HOST=mail.tnaprovider.com.au
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=true
MAIL_IMAP_USER=info@tnaprovider.com.au
MAIL_IMAP_PASS=change-me

# Stalwart JMAP (used when MAIL_PROVIDER=stalwart)
MAIL_JMAP_URL=https://mail.tnaprovider.com.au/jmap
MAIL_ADMIN_TOKEN=change-me

# Mailbox config
MAIL_DOMAIN=tnaprovider.com.au
MAIL_DEFAULT_MAILBOX=info@tnaprovider.com.au
MAIL_ALLOWED_MAILBOXES=info@tnaprovider.com.au,projects@tnaprovider.com.au,accounts@tnaprovider.com.au

# Staging only: allow x-mailbox header to switch mailbox (never true in production)
MAIL_ALLOW_HEADER_MAILBOX=false

# Session & Auth
SESSION_SECRET=
SESSION_COOKIE_NAME=tna_session
SESSION_TTL_HOURS=12

# Database
DATABASE_URL=

# Seed (local dev only — set before running npm run db:seed)
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=

# Rate limiting
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# App
APP_ENV=development
APP_BASE_URL=http://localhost:3000

# Frontend
VITE_EMAIL_MOCK_MODE=true
