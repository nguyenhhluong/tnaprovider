# TNA Provider — Environment Configuration Template
# Copy to .env and fill in your values.
# Never commit this file with real secrets.

# Application
APP_ENV=production
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Database (SQLite)
DATABASE_URL=/var/lib/tnaprovider/tna.db

# Session
SESSION_SECRET=<generate a random 64+ character string>
SESSION_COOKIE_NAME=tna_session
SESSION_TTL_HOURS=24

# Email (mock for now)
MAIL_PROVIDER=mock
MAIL_DEFAULT_MAILBOX=info@tnaprovider.com.au
MAIL_ALLOWED_MAILBOXES=info@tnaprovider.com.au

# URLs
APP_URL=https://app.tnaprovider.com.au
APP_BASE_URL=https://tnaprovider.com.au

# Rate limiting
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Gemini AI (optional)
# GEMINI_API_KEY=
