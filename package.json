{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "prerender": "node scripts/prerender.mjs",
    "postbuild": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "server": "node server.js",
    "start": "node server.js",
    "preview:server": "NODE_ENV=production node server.js",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "db:migrate": "node --input-type=module -e \"import {migrate} from './server/db/migrate.js'; migrate();\"",
    "db:seed": "node --input-type=module -e \"import {seed} from './server/db/seed.js'; seed();\"",
    "db:reset": "node --input-type=module -e \"import fs from 'fs'; import {migrate} from './server/db/migrate.js'; import {seed} from './server/db/seed.js'; try{fs.unlinkSync(process.env.DATABASE_URL||'data/tna.db');console.log('Database deleted');}catch(e){} migrate(); seed();\"",
    "test:routes": "node scripts/qa/routes-smoke.mjs",
    "test:api": "node scripts/qa/api-contracts.mjs",
    "test:roles": "node scripts/qa/role-access.mjs",
    "test:payroll": "node scripts/qa/payroll-rules.mjs",
    "test:phase7h": "npm run test:routes && npm run test:api && npm run test:roles && npm run test:payroll",
    "test:phase8b": "node scripts/qa/phase8b-user-rates-timesheet-consistency.mjs",
    "test:phase8d": "node scripts/qa/phase8d-worker-profile-timesheet-review.mjs",
    "test:phase8c": "node scripts/qa/phase8c-qr-quick-checkin-checkout.mjs",
    "test:phase8e": "node scripts/qa/phase8e-timesheet-history.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "crypto": "^1.0.1",
    "dompurify": "^3.4.11",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "imapflow": "^1.4.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.1",
    "react-router-hash-link": "^2.4.3",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-hash-link": "^2.4.9",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.61.1",
    "puppeteer": "^25.2.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
